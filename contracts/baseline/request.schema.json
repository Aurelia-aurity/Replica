{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed baseline request",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 16000
    },
    "history": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 16000
          },
          "assistant": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 16000
          }
        },
        "required": [
          "user",
          "assistant"
        ],
        "additionalProperties": false
      }
    },
    "max_new_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    }
  },
  "required": [
    "request_id",
    "message",
    "history",
    "max_new_tokens"
  ],
  "additionalProperties": false
}
