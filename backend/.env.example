# 이 파일을 복사해 .env를 만들고 값을 채우세요. .env는 Git에 올리지 않습니다.
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# mock: 고정 응답 / remote: 학교 GPU 서버 호출
LLM_MODE=mock
# LLM_MODE=remote일 때 필요. 시간 제한(초)은 GPU 측정과 담당자 합의 후 정한다(기본값 없음).
# LLM_SERVER_URL=
# LLM_SERVER_TOKEN=
# LLM_TIMEOUT_SECONDS=
# LLM_MODEL_NAME=Qwen2.5-7B-Instruct
# mock 또는 공급자 이름 (STT/TTS 담당과 확정 후 기입)
STT_PROVIDER=mock
TTS_PROVIDER=mock

# 이후 추가 예정 (값은 .env에만 기록)
# STT_API_KEY=
# TTS_API_KEY=
MAX_UPLOAD_MB=25

# 로그인 확인·DB 접근. 이 .env 파일에서 읽고, 같은 이름의 실제 환경변수가 있으면 그 값이 우선한다.
# 앱(mobile)이 쓰는 SUPABASE_URL과 같은 프로젝트여야 로그인 토큰이 확인된다. 서버 비밀 키는 .env에만 두고 앱·저장소에 넣지 않는다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_fake
SUPABASE_SECRET_KEY=sb_secret_fake
SUPABASE_DB_TIMEOUT_SECONDS=10

# 기존 키를 사용할 때 위 두 키 대신 아래 이름을 사용할 수 있습니다.
# SUPABASE_ANON_KEY=fake-anon-jwt
# SUPABASE_SERVICE_ROLE_KEY=fake-service-role-jwt

# 실제 연결 검사는 기본 비활성. 임시 계정 생성·정리는 명시적 동의 후 실행합니다.
# REPLICA_DB_LIVE_TEST=1
# REPLICA_DB_TEST_ACCESS_TOKEN=fake-user-access-token
# REPLICA_DB_MUTATING_TEST=1
