# 구현 시 필요한 변수 이름과 가짜 예시 값을 추가하세요.
# 실제 API 키·비밀번호·서비스 자격 증명을 이 파일에 넣지 마세요.

# DB 접속 (RLS를 우회하는 postgres 역할이므로 서버에서만 사용)
# 로컬 Supabase 기본값. 클라우드 접속 문자열은 팀 공유 채널에서 받아 .env에만 넣는다.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MAX_SIZE=5

# baseline 고정 사용자·페르소나. 아래 값은 infra/supabase/seed.sql의 로컬 시험 계정 A다.
# 클라우드에서는 그 프로젝트에 만든 시험 계정의 id로 바꾼다.
BASELINE_USER_ID=a0000000-0000-4000-8000-000000000001
BASELINE_PERSONA_ID=b0000000-0000-4000-8000-000000000001

# DB 테스트용 (로컬 Supabase만. 원격 주소를 넣지 않는다)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
