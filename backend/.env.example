# 이 파일을 복사해 .env를 만들고 값을 채우세요. .env는 Git에 올리지 않습니다.
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# mock: 고정 응답 / remote: 학교 GPU 서버 호출
LLM_MODE=mock
# mock 또는 공급자 이름 (STT/TTS 담당과 확정 후 기입)
STT_PROVIDER=mock
TTS_PROVIDER=mock

# 이후 추가 예정 (값은 .env에만 기록)
# LLM_SERVER_URL=
# LLM_SERVER_TOKEN=
# STT_API_KEY=
# TTS_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
MAX_UPLOAD_MB=25
